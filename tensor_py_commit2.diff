+def cos_sim_exp_tens(
+    dens_x,
+    dens_y,
+    *,
+    mode: str = "auto",
+    dedup: bool = True,
+    verbose: bool = True,
+):
+    """Cosine similarity of two expectation tensor densities.
+
+    Accepts polymorphic input: each of ``dens_x`` and ``dens_y`` may be
+    a single density object or a list/tuple of densities. Output shape
+    follows the input shapes:
+
+    +-----------------+-----------------+----------------------------------+
+    | dens_x          | dens_y          | output                           |
+    +=================+=================+==================================+
+    | scalar          | scalar          | scalar (the v2.0 case, unchanged)|
+    +-----------------+-----------------+----------------------------------+
+    | scalar          | list of length N| array of shape ``(N,)``          |
+    +-----------------+-----------------+----------------------------------+
+    | list of length M| scalar          | array of shape ``(M,)``          |
+    +-----------------+-----------------+----------------------------------+
+    | list of length M| list of length N| ``mode``-dependent (see below)   |
+    +-----------------+-----------------+----------------------------------+
+
+    Length-1 lists collapse to scalars (so ``cos_sim_exp_tens(A, [B])``
+    returns a scalar, not a length-1 array). Empty lists return an
+    empty array of the appropriate shape.
+
+    For the list-vs-list case, ``mode`` selects:
+
+    - ``'pairwise'`` (requires ``M == N``): ``result[i] = cos_sim(A[i], B[i])``,
+      shape ``(M,)``.
+    - ``'cartesian'``: ``result[i, j] = cos_sim(A[i], B[j])``, shape ``(M, N)``.
+    - ``'auto'`` (default): resolves to ``'pairwise'`` if ``M == N``,
+      otherwise raises with a message suggesting ``'cartesian'``.
+
+    Parameters
+    ----------
+    dens_x, dens_y : ExpTensDensity, MaetDensity, WindowedMaetDensity, or list/tuple of these
+        Density objects from :func:`build_exp_tens` (and optionally
+        :func:`window_tensor`). Mixing density types within a single
+        list raises ``TypeError`` at the per-pair core call.
+    mode : {'auto', 'pairwise', 'cartesian'}, default 'auto'
+        Selects pairwise vs Cartesian semantics in the list-vs-list
+        case. Ignored when at least one argument is a (post-collapse)
+        scalar.
+    dedup : bool, default True
+        Apply canonical-form deduplication: pairs that are
+        structurally equivalent under the relevant symmetries
+        (independent transposition for relative modes; joint
+        co-transposition and octave equivalence for absolute modes)
+        are detected and computed once. Currently supported for
+        single-attribute (``ExpTensDensity``) pairs only; pairs
+        involving ``MaetDensity`` or ``WindowedMaetDensity`` bypass
+        dedup transparently. Pass ``dedup=False`` to bypass dedup
+        unconditionally (useful as a regression-testing baseline).
+    verbose : bool, default True
+        Print progress.
+
+    Returns
+    -------
+    float or np.ndarray
+        Scalar in the scalar-vs-scalar case; otherwise an ndarray
+        with the shape table above.
+
+    See Also
+    --------
+    build_exp_tens, eval_exp_tens, batch_cos_sim_exp_tens
+
+    References
+    ----------
+    Originally by David Bulger, Macquarie University (2016).
+    Adapted for the Music Perception Toolbox v2 by Andrew J. Milne.
+    """
+    treat_x_scalar, list_x = _normalize_density_input(dens_x, name="dens_x")
+    treat_y_scalar, list_y = _normalize_density_input(dens_y, name="dens_y")
+
+    # Scalar-vs-scalar fast path: identical to v2.0 behaviour.
+    if treat_x_scalar and treat_y_scalar and len(list_x) and len(list_y):
+        return _cos_sim_pair_core(list_x[0], list_y[0], verbose=verbose)
+
+    m = len(list_x)
+    n = len(list_y)
+
+    # Determine pair list and output shape.
+    if treat_x_scalar and len(list_x) == 0:
+        # Empty x and any y: empty output.
+        if treat_y_scalar:
+            return np.array([], dtype=np.float64)
+        return np.empty((0,), dtype=np.float64)
+    if treat_y_scalar and len(list_y) == 0:
+        # Empty y and any x: empty output.
+        if treat_x_scalar:
+            return np.array([], dtype=np.float64)
+        return np.empty((0,), dtype=np.float64)
+
+    if treat_x_scalar:
+        # Scalar-vs-list (broadcast).
+        a = list_x[0]
+        pairs = [(a, b) for b in list_y]
+        out_shape = (n,)
+    elif treat_y_scalar:
+        # List-vs-scalar (broadcast).
+        b = list_y[0]
+        pairs = [(a, b) for a in list_x]
+        out_shape = (m,)
+    else:
+        # List-vs-list. Empty cases:
+        if m == 0 and n == 0:
+            resolved = _resolve_list_list_mode(mode, m, n) if mode != "auto" else "pairwise"
+            return np.empty(((0,) if resolved == "pairwise" else (0, 0)), dtype=np.float64)
+        if m == 0:
+            resolved = _resolve_list_list_mode(mode, m, n)
+            return np.empty(((0,) if resolved == "pairwise" else (0, n)), dtype=np.float64)
+        if n == 0:
+            resolved = _resolve_list_list_mode(mode, m, n)
+            return np.empty(((0,) if resolved == "pairwise" else (m, 0)), dtype=np.float64)
+
+        resolved = _resolve_list_list_mode(mode, m, n)
+        if resolved == "pairwise":
+            pairs = list(zip(list_x, list_y))
+            out_shape = (m,)
+        else:  # cartesian
+            pairs = [(a, b) for a in list_x for b in list_y]
+            out_shape = (m, n)
+
+    # Compute per-pair similarities, optionally deduplicating.
+    if dedup and _all_sa_pairs(pairs):
+        results = _compute_pair_results_with_dedup_sa(pairs, verbose=verbose)
+    else:
+        if dedup and verbose:
+            # Inform the user that dedup was requested but bypassed
+            # because the input includes non-SA densities.
+            print(
+                "cos_sim_exp_tens: dedup=True requested but input includes "
+                "non-SA densities; computing without dedup."
+            )
+        results = _compute_pair_results_no_dedup(pairs, verbose=verbose)
+
+    return np.array(results, dtype=np.float64).reshape(out_shape)
+
