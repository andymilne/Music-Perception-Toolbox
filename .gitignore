
.DS_Store
__pycache__/
*.diff
APPLY_NOTES.txt

# MATLAB editor autosaves.
*.asv

# Calibration run outputs. Each is the default output path of a
# calibration tool, so a committed copy is a stale run the next one
# silently overwrites; the fitted constants live in the source, with
# their provenance in the comment beside them.
relIpCost.csv
relIpCostMATLAB.txt
python/rel_ip_cost.csv
python/py_bench.txt
python/py_bench_ext.txt
python/progress.txt

# Benchmark, audit, and demo run outputs. Each is written by a script
# that lives in the repository, so a committed copy is a stale run the
# next invocation silently overwrites.
tools/bench_xlang/*.csv
tools/bench_xlang/*.log
tools/bench_xlang/bench_mobius_log.txt
bench_mobius_*.csv
python/tests/precision_audit/*.out.txt
python/figures/
python/demos/*.png
python/dist/
python/demos/jmm/figures/
matlab/demos/jmm/figures/

# Coltrane, Acknowledgement. The transcription of the solo is not
# distributed with the toolbox; the demos read whatever monophonic MIDI
# transcription the user places at these paths.
python/demos/jmm/data/AwakeningSolo.mid
matlab/demos/jmm/data/AwakeningSolo.mid

# Ren, Rammos, and Rohrmeier's (2024) rule-labelled derivations of the
# Jazz Harmony Treebank, read by the supplied-parse demo. Public, but
# not ours to redistribute; the demo says where to fetch it.
python/demos/jmm/data/ParseTrees.json
matlab/demos/jmm/data/ParseTrees.json
